{
  "branch" : "main",
  "build_workers" : 2,
  "copy_original_assets" : true,
  "defaults" : {
    "description" : "",
    "software_name" : "Y2Player",
    "target_model" : "Y2",
    "target_type" : "Stock"
  },
  "firmware" : {
    "exclude" : [
      "*-windows.zip",
      "*-windows-arm64.zip",
      "*-linux.zip",
      "*-linux-arm64.zip",
      "*-macos.zip",
      "*portable*.zip",
      "*source*.zip",
      "*installer*.zip",
      "*.dmg",
      "*.apk",
      "*.tar.gz",
      "*.tgz",
      "*.tar",
      "*.sha256",
      "*.json",
      "*.txt",
      "*.sig",
      "*.img.gz",
      "*.exe",
      "*.appimage"
    ],
    "include" : [
      "*.zip"
    ],
    "require_scatter" : true
  },
  "max_asset_bytes" : 2147483648,
  "mirror_repo" : "y1-community/y2player-mirror",
  "platforms" : {
    "linux" : {
      "arch" : "x86-64",
      "layout" : "sp_flash_tool",
      "os" : "linux",
      "suffix" : "-linux.zip",
      "updater_asset" : "UpdaterCE-Linux-Portable.zip"
    },
    "linux-arm64" : {
      "arch" : "arm64",
      "layout" : "sp_flash_tool",
      "optional" : true,
      "os" : "linux",
      "suffix" : "-linux-arm64.zip",
      "updater_asset" : "UpdaterCE-Linux-Portable-arm64.zip"
    },
    "macos" : {
      "arch" : "universal",
      "layout" : "beside_app",
      "os" : "macos",
      "suffix" : "-macos.zip",
      "updater_asset" : "Innioasis.Updater.for.Mac.zip"
    },
    "windows" : {
      "arch" : "x86-64",
      "layout" : "sp_flash_tool",
      "os" : "windows",
      "suffix" : "-windows.zip",
      "updater_asset" : "UpdaterCE-Windows-Portable.zip"
    },
    "windows-arm64" : {
      "arch" : "arm64",
      "layout" : "sp_flash_tool",
      "optional" : true,
      "os" : "windows",
      "suffix" : "-windows-arm64.zip",
      "updater_asset" : "UpdaterCE-Windows-Portable-arm64.zip"
    }
  },
  "releases" : {
    "exclude_tags" : [

    ],
    "include_prereleases" : true,
    "tags" : [

    ]
  },
  "rules" : [
    {
      "match_asset" : "(?i)360p",
      "target_type" : "360p"
    },
    {
      "match_asset" : "(?i)240p",
      "target_type" : "240p"
    },
    {
      "match_asset" : "(?i)rom_y1_type[-_ ]?a",
      "target_model" : "Y1",
      "target_type" : "Type A"
    },
    {
      "match_asset" : "(?i)rom_y1_type[-_ ]?b",
      "target_model" : "Y1",
      "target_type" : "Type B"
    },
    {
      "match_asset" : "(?i)type[-_ ]?b",
      "target_model" : "Y2",
      "target_type" : "Type B"
    },
    {
      "match_asset" : "(?i)(^|[-_.])y2([-_.]|$)",
      "target_model" : "Y2",
      "target_type" : "Stock"
    }
  ],
  "source_readme" : {
    "commit_message" : "Mirror source README",
    "enabled" : true,
    "path" : "README.md"
  },
  "source_repo" : "schulzcode/Y2Player",
  "title_prefix" : "Portable Flashing Package: ",
  "updater_repo" : "y1-community/updater-ce-neo"
}
